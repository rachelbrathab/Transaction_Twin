# Application
APP_ENV=development
LOG_LEVEL=INFO

# Database
DATABASE_URL=postgresql+asyncpg://transaction_twin:transaction_twin@localhost:5432/transaction_twin

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# Redis
REDIS_URL=redis://localhost:6379/0

# API
API_V1_PREFIX=/api/v1

# Razorpay (future — do NOT use real credentials)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# LLM (future — do NOT commit real keys)
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx

# Authentication — MUST be overridden in production
JWT_SECRET_KEY=dev-secret-change-in-production
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Production overrides (when APP_ENV=production)
# JWT_SECRET_KEY=<64-char-random-string>
# DATABASE_URL=postgresql+asyncpg://user:password@db-host:5432/transaction_twin
# CORS_ORIGINS=https://app.yourdomain.com
# REDIS_URL=redis://redis-host:6379/0
