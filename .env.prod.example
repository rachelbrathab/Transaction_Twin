# Transaction Twin — Production Environment Configuration
#
# Copy this file to .env.prod and fill in the values.
# NEVER commit .env.prod to version control.
#
# Usage:
#   cp .env.prod.example .env.prod
#   # Edit .env.prod with your values
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Application ────────────────────────────────────────────────────
APP_ENV=production
LOG_LEVEL=INFO

# ── Database ───────────────────────────────────────────────────────
# Use a strong password. Generate with: openssl rand -base64 32
POSTGRES_USER=transaction_twin
POSTGRES_PASSWORD=<CHANGE-ME-strong-random-password>
POSTGRES_DB=transaction_twin

# ── Redis ──────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ── CORS ───────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=https://app.yourdomain.com

# ── Domain ─────────────────────────────────────────────────────────
# Your production domain (used by Caddy for TLS)
DOMAIN=app.yourdomain.com

# ── Authentication ─────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET_KEY=<CHANGE-ME-generate-a-secure-random-secret>
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Public API URL ─────────────────────────────────────────────────
# The URL the frontend uses to reach the backend API
NEXT_PUBLIC_API_URL=https://app.yourdomain.com

# ── Future (placeholders only — do NOT fill in production values) ──
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# LLM_API_KEY=
# GEMINI_API_KEY=
